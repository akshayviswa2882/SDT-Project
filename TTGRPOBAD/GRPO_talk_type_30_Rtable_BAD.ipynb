    "# ============================================================================\n",
    "# CELL 3: Load Data (local path)\n",
    "# ============================================================================\n",
    "# Load CSV from home directory\n",
    "df = pd.read_csv('/AnnoMI-tr0-SDT.csv')  # Adjust if path differs\n",
    "\n",
    "high_ids = df[df[\"mi_quality\"]==\"high\"][\"transcript_id\"].unique()\n",
    "low_ids = df[df[\"mi_quality\"]==\"low\"][\"transcript_id\"].unique()\n",
    "\n",
    "high_ids = np.array(high_ids)\n",
    "low_ids = np.array(low_ids)\n",
    "\n",
    "train_transcripts = set(list(high_ids[:25]) + list(low_ids[:5]))\n",
    "all_transcripts = set(df['transcript_id'].unique())\n",
    "grpo_transcripts = all_transcripts - train_transcripts\n",
    "\n",
    "grpo_df = df[df['transcript_id'].isin(grpo_transcripts)].reset_index(drop=True)\n",
    "\n",
    "print(f\"Loaded {len(grpo_df)} GRPO samples from {len(grpo_transcripts)} transcripts\")"
   ]
