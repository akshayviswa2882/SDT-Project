    "# Plot 3: Predicted labels before GRPO\n",
    "print(\"\\nPlot 3: Talk Type Distribution\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Before GRPO\n",
    "label_counts_before = {'change': 0, 'neutral': 0, 'sustain': 0}\n",
    "for batch in grpo_training_data:\n",
    "    for label in batch['pred_labels']:\n",
    "        label_counts_before[label] += 1\n",
    "\n",
    "axes[0].bar(label_counts_before.keys(), label_counts_before.values(), color=['green', 'gray', 'red'], alpha=0.7)\n",
    "axes[0].set_ylabel('Count')\n",
    "axes[0].set_title('Predicted Talk Types (Before GRPO)')\n",
    "axes[0].set_ylim([0, 150])\n",
    "for i, (k, v) in enumerate(label_counts_before.items()):\n",
    "    axes[0].text(i, v + 2, str(v), ha='center', fontweight='bold')\n",
    "\n",
    "# After GRPO (sample)\n",
    "label_counts_after = {'change': 0, 'neutral': 0, 'sustain': 0}\n",
    "for i, batch in enumerate(grpo_training_data[:10]):\n",
    "    context = batch['prompt']\n",
    "    for response in batch['responses']:\n",
    "        pred = predict_client_talk_type_llm(context, response)\n",
    "        label_counts_after[pred] += 1\n",
    "\n",
    "axes[1].bar(label_counts_after.keys(), label_counts_after.values(), color=['green', 'gray', 'red'], alpha=0.7)\n",
    "axes[1].set_ylabel('Count')\n",
    "axes[1].set_title('Predicted Talk Types (Sample After GRPO)')\n",
    "axes[1].set_ylim([0, 150])\n",
    "for i, (k, v) in enumerate(label_counts_after.items()):\n",
    "    axes[1].text(i, v + 2, str(v), ha='center', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('/root/grpo_talk_types.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f\"✓ Talk type distribution saved: /root/grpo_talk_types.png\")\n"
   ]
