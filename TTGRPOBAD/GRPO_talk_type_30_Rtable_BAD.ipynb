    "# ============================================================================\n",
    "# CELL 6: Build GRPO Training Data (with GT talk_type)\n",
    "# ============================================================================\n",
    "print(\"Building GRPO prompts...\")\n",
    "\n",
    "grpo_prompts = []\n",
    "\n",
    "for tid in sorted(list(grpo_transcripts)):\n",
    "    tid_df = grpo_df[grpo_df['transcript_id'] == tid].sort_values('utterance_id')\n",
    "    \n",
    "    for idx, row in tid_df.iterrows():\n",
    "        # Only process client turns\n",
    "        if row['interlocutor'] != 'client':\n",
    "            continue\n",
    "        \n",
    "        uid = row['utterance_id']\n",
    "        \n",
    "        # Skip if no prior therapist turn\n",
    "        if uid == 0:\n",
    "            continue\n",
    "        \n",
    "        # Build context up to this client turn (include the client turn)\n",
    "        context_df = tid_df[tid_df['utterance_id'] <= uid].sort_values('utterance_id')\n",
    "        \n",
    "        context_lines = []\n",
    "        for _, ctx_row in context_df.iterrows():\n",
    "            speaker = \"Therapist\" if ctx_row['interlocutor'] == \"therapist\" else \"Client\"\n",
    "            context_lines.append(f\"{speaker}: {ctx_row['utterance_text']}\")\n",
    "        \n",
    "        context_text = \"\\n\".join(context_lines)\n",
    "        \n",
    "        # Get GT: the NEXT client turn's talk_type\n",
    "        next_client_df = tid_df[(tid_df['interlocutor'] == 'client') & (tid_df['utterance_id'] > uid)]\n",
    "        \n",
    "        if len(next_client_df) > 0:\n",
    "            gt_talk_type = next_client_df.iloc[0]['client_talk_type']\n",
    "        else:\n",
    "            gt_talk_type = 'neutral'  # Default if no next client turn\n",
    "        \n",
    "        grpo_prompts.append({\n",
    "            \"prompt\": context_text,\n",
    "            \"transcript_id\": tid,\n",
    "            \"utterance_id\": uid,\n",
    "            \"gt_talk_type\": gt_talk_type  # ADD THIS\n",
    "        })\n",
    "\n",
    "print(f\"Created {len(grpo_prompts)} GRPO prompts\")\n",
    "print(f\"Example prompt with gt_talk_type: {grpo_prompts[0]}\")"
   ]
