   "source": [
    "# ============================================================================\n",
    "# CELL 14: Inspect GRPO Value Added\n",
    "# ============================================================================\n",
    "%pip install matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"INSPECTING GRPO VALUE ADDED\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Plot 1: Reward distribution before vs after\n",
    "print(\"\\nPlot 1: Reward Distribution\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Before GRPO (from GRPO data prep)\n",
    "before_rewards = []\n",
    "for batch in grpo_training_data:\n",
    "    before_rewards.extend(batch['rewards'])\n",
    "\n",
    "axes[0].hist(before_rewards, bins=20, edgecolor='black', alpha=0.7, color='orange')\n",
    "axes[0].set_xlabel('Reward Score')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].set_title('Reward Distribution (Before GRPO Training)')\n",
    "axes[0].axvline(np.mean(before_rewards), color='red', linestyle='--', label=f'Mean: {np.mean(before_rewards):.3f}')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# After GRPO (rescore with LLM)\n",
    "print(\"Rescoring GRPO data post-training...\")\n",
    "after_rewards = []\n",
    "for i, batch in enumerate(grpo_training_data[:10]):  # Sample 10 batches for speed\n",
    "    context = batch['prompt']\n",
    "    for response in batch['responses']:\n",
    "        pred_label = predict_client_talk_type_llm(context, response)\n",
    "        reward = REWARD_TABLE.get((batch['gt_talk_type'], pred_label), 0.5)\n",
    "        after_rewards.append(reward)\n",
    "    if (i + 1) % 5 == 0:\n",
    "        print(f\"  Rescored {i+1}/10 batches...\")\n",
    "\n",
    "axes[1].hist(after_rewards, bins=20, edgecolor='black', alpha=0.7, color='green')\n",
    "axes[1].set_xlabel('Reward Score')\n",
    "axes[1].set_ylabel('Frequency')\n",
    "axes[1].set_title('Reward Distribution (Sample After GRPO)')\n",
    "axes[1].axvline(np.mean(after_rewards), color='red', linestyle='--', label=f'Mean: {np.mean(after_rewards):.3f}')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('/root/grpo_reward_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f\"\\n✓ Reward comparison saved: /root/grpo_reward_comparison.png\")\n",
    "\n",
    "# Print statistics\n",
    "print(f\"\\nReward Statistics:\")\n",
    "print(f\"  Before GRPO: Mean={np.mean(before_rewards):.3f}, Std={np.std(before_rewards):.3f}\")\n",
    "print(f\"  After GRPO:  Mean={np.mean(after_rewards):.3f}, Std={np.std(after_rewards):.3f}\")\n"
   ]
