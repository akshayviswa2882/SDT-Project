    "# ============================================================================\n",
    "# CELL 5: Setup OpenAI API & Reward Table (Updated for v1.0+)\n",
    "# ============================================================================\n",
    "%pip install openai\n",
    "from openai import OpenAI\n",
    "\n",
    "# Initialize client with hardcoded key\n",
    "client = OpenAI(api_key=\"")\n",
    "\n",
    "# Reward table (same as before)\n",
    "REWARD_TABLE = {\n",
    "    ('change', 'change'):   1.0,\n",
    "    ('change', 'neutral'):  0.7,\n",
    "    ('change', 'sustain'):  0.15,\n",
    "    ('neutral', 'change'):  0.9,\n",
    "    ('neutral', 'neutral'): 1.0,\n",
    "    ('neutral', 'sustain'): 0.3,\n",
    "    ('sustain', 'change'):  0.95,\n",
    "    ('sustain', 'neutral'): 0.4,\n",
    "    ('sustain', 'sustain'): 1.0,\n",
    "}\n",
    "\n",
    "def predict_client_talk_type_llm(context, therapist_utt):\n",
    "    \"\"\"Use GPT to predict client talk_type\"\"\"\n",
    "    prompt = f\"\"\"Given this therapy conversation:\n",
    "\n",
    "{context}\n",
    "\n",
    "Therapist: {therapist_utt}\n",
    "\n",
    "What type of client response would likely follow?\n",
    "- \"change\": Commitment to change (\"I should quit\", \"I'm ready\")\n",
    "- \"neutral\": Ambivalent (\"Maybe\", \"I don't know\")\n",
    "- \"sustain\": Resistance (\"I don't want to\", \"It won't help\")\n",
    "\n",
    "Respond with ONLY one word: change, neutral, or sustain\"\"\"\n",
    "\n",
    "    response = client.chat.completions.create(\n",
    "        model=\"gpt-3.5-turbo\",\n",
    "        max_tokens=10,\n",
    "        temperature=0.3,\n",
    "        messages=[{\"role\": \"user\", \"content\": prompt}]\n",
    "    )\n",
    "    \n",
    "    response_text = response.choices[0].message.content.strip().lower()\n",
    "    \n",
    "    if 'change' in response_text:\n",
    "        return 'change'\n",
    "    elif 'sustain' in response_text:\n",
    "        return 'sustain'\n",
    "    else:\n",
    "        return 'neutral'\n",
    "\n",
    "print(\"✓ OpenAI API v1.0+ ready\")\n",
    "print(\"✓ Reward table loaded\")"
   ]
  },
