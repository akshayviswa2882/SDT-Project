   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Generating responses and computing rewards...\n",
      "Processed 10/50 prompts\n",
      "  Mean reward: 1.000\n",
      "  Predicted labels: ['sustain', 'sustain', 'sustain', 'sustain']\n",
      "Processed 20/50 prompts\n",
      "  Mean reward: 0.537\n",
      "  Predicted labels: ['change', 'neutral', 'neutral', 'neutral']\n",
      "Processed 30/50 prompts\n",
      "  Mean reward: 1.000\n",
      "  Predicted labels: ['change', 'change', 'change', 'change']\n",
      "Processed 40/50 prompts\n",
      "  Mean reward: 0.900\n",
      "  Predicted labels: ['change', 'change', 'change', 'change']\n",
      "Processed 50/50 prompts\n",
      "  Mean reward: 0.900\n",
      "  Predicted labels: ['change', 'change', 'change', 'change']\n",
      "\n",
      "GRPO training data prepared: 50 batches\n"
     ]
    }
   ],
   "source": [
    "# ============================================================================\n",
    "# CELL 7: GRPO Generation & Scoring with LLM Oracle\n",
    "# ============================================================================\n",
    "print(\"Generating responses and computing rewards...\")\n",
    "\n",
    "GRPO_BATCH_SIZE = 4\n",
    "NUM_PROMPTS_TO_TRAIN = 50\n",
    "K = GRPO_BATCH_SIZE\n",
    "\n",
    "grpo_training_data = []\n",
    "\n",
    "for i, prompt_dict in enumerate(grpo_prompts[:NUM_PROMPTS_TO_TRAIN]):\n",
    "    prompt = prompt_dict['prompt']\n",
    "    gt_talk_type = prompt_dict['gt_talk_type']  # From dataset\n",
    "\n",
    "    # Add instruction\n",
    "    full_prompt = (\n",
    "        \"You are a motivational interviewing therapist. \"\n",
    "        \"Generate the next therapist response given the conversation history. \"\n",
    "        \"Respond as the therapist only.\\n\\n\"\n",
    "        f\"Conversation History:\\n{prompt}\\n\\nGenerate the next therapist response.\"\n",
    "    )\n",
    "\n",
    "    # Tokenize\n",
    "    inputs = tokenizer(\n",
    "        full_prompt,\n",
    "        return_tensors='pt',\n",
    "        truncation=True,\n",
    "        max_length=1024\n",
    "    ).to(policy_model.device)\n",
    "\n",
    "    # Generate K responses\n",
    "    with torch.no_grad():\n",
    "        outputs = policy_model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=60,\n",
    "            num_return_sequences=K,\n",
    "            temperature=0.7,\n",
    "            top_p=0.9,\n",
    "            do_sample=True,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "            eos_token_id=tokenizer.eos_token_id\n",
    "        )\n",
    "\n",
    "    # Decode responses\n",
    "    responses = []\n",
    "    for output in outputs:\n",
    "        generated_tokens = output[inputs.input_ids.shape[1]:]\n",
    "        response = tokenizer.decode(generated_tokens, skip_special_tokens=True).strip()\n",
    "\n",
    "        # Clean: remove client dialogue if present\n",
    "        if \"Client:\" in response:\n",
    "            response = response.split(\"Client:\")[0].strip()\n",
    "\n",
    "        responses.append(response)\n",
    "\n",
    "    # Score K responses using LLM oracle\n",
    "    predicted_labels = []\n",
    "    rewards = []\n",
    "\n",
    "    for response in responses:\n",
    "        # LLM predicts what client talk_type would be\n",
    "        pred_label = predict_client_talk_type_llm(prompt, response)\n",
    "        predicted_labels.append(pred_label)\n",
    "\n",
    "        # Look up reward in table\n",
    "        reward = REWARD_TABLE.get((gt_talk_type, pred_label), 0.5)\n",
    "        rewards.append(reward)\n",
    "\n",
    "    # Compute advantages\n",
    "    mean_reward = np.mean(rewards)\n",
    "    advantages = np.array([r - mean_reward for r in rewards])\n",
    "\n",
    "    # Store training sample\n",
    "    grpo_training_data.append({\n",
    "        \"prompt\": prompt,\n",
    "        \"responses\": responses,\n",
    "        \"rewards\": np.array(rewards),\n",
    "        \"advantages\": advantages,\n",
    "        \"pred_labels\": predicted_labels,\n",
    "        \"gt_talk_type\": gt_talk_type,\n",
    "        \"mean_reward\": mean_reward\n",
