    "# Plot 2: Advantage statistics\n",
    "print(\"\\nPlot 2: Advantage Distribution (Training Signal)\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "all_advantages = []\n",
    "for batch in grpo_training_data:\n",
    "    all_advantages.extend(batch['advantages'])\n",
    "\n",
    "ax.hist(all_advantages, bins=30, edgecolor='black', alpha=0.7, color='blue')\n",
    "ax.set_xlabel('Advantage Value')\n",
    "ax.set_ylabel('Frequency')\n",
    "ax.set_title('GRPO Advantage Distribution (What Policy Learned From)')\n",
    "ax.axvline(0, color='red', linestyle='--', label='Zero line')\n",
    "ax.axvline(np.mean(all_advantages), color='green', linestyle='--', label=f'Mean: {np.mean(all_advantages):.4f}')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('/root/grpo_advantages.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f\"✓ Advantage distribution saved: /root/grpo_advantages.png\")\n",
    "print(f\"  Advantage Std (signal strength): {np.std(all_advantages):.4f}\")"
   ]
