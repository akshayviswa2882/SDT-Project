    "# ============================================================================\n",
    "# CELL 11: GRPO Training with TRL (LLM Oracle)\n",
    "# ============================================================================\n",
    "from trl import GRPOTrainer, GRPOConfig\n",
    "from datasets import Dataset\n",
    "\n",
    "print(\"Preparing GRPO dataset...\")\n",
    "\n",
    "# Convert grpo_training_data to TRL format\n",
    "grpo_train_list = []\n",
    "for batch in grpo_training_data:\n",
    "    for response, reward in zip(batch['responses'], batch['rewards']):\n",
    "        grpo_train_list.append({\n",
    "            'prompt': batch['prompt'],\n",
    "            'completion': response,\n",
    "        })\n",
    "\n",
    "grpo_dataset = Dataset.from_list(grpo_train_list)\n",
    "print(f\"GRPO dataset size: {len(grpo_dataset)}\")\n",
    "\n",
    "# Define reward function using LLM oracle\n",
    "def compute_rewards(completions, **kwargs):\n",
    "    \"\"\"Score completions using LLM oracle + reward table\"\"\"\n",
    "    prompts = kwargs.get('prompts', [])\n",
    "    rewards = []\n",
    "    \n",
    "    for prompt, completion in zip(prompts, completions):\n",
    "        # Find GT talk_type from grpo_training_data\n",
    "        gt_talk_type = 'neutral'\n",
    "        for batch in grpo_training_data:\n",
    "            if batch['prompt'] in prompt:\n",
    "                gt_talk_type = batch['gt_talk_type']\n",
    "                break\n",
    "        \n",
    "        # LLM predicts client talk_type\n",
    "        pred_label = predict_client_talk_type_llm(prompt, completion)\n",
    "        \n",
    "        # Look up reward in table\n",
    "        reward = REWARD_TABLE.get((gt_talk_type, pred_label), 0.5)\n",
    "        rewards.append(reward)\n",
    "    \n",
    "    return rewards\n",
    "\n",
    "# GRPO Config (same hyperparameters)\n",
    "grpo_config = GRPOConfig(\n",
    "    output_dir=\"/root/grpo_output\",\n",
    "    per_device_train_batch_size=8,\n",
    "    num_train_epochs=2,\n",
    "    learning_rate=1e-5,\n",
    "    bf16=True,\n",
    "    logging_steps=5,\n",
    "    save_steps=50,\n",
    "    num_generations=4,\n",
    "    max_completion_length=60,\n",
    "    temperature=0.7,\n",
    "    top_p=0.9,\n",
